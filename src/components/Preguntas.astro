---
import { preguntas } from '../config/site';
---

<section id="preguntas" aria-labelledby="faq-titulo" class="bg-slate-50">
  <div class="contenedor py-16">
    <h2 id="faq-titulo" class="text-3xl font-bold text-marca-900">Preguntas frecuentes</h2>
    <div class="mt-8 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
      {preguntas.map((q) => (
        <details class="group p-5">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between font-semibold">
            {q.p}
            <span class="ml-4 text-xl text-marca-600 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-700">{q.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
