---
/** Preguntas con la respuesta siempre visible (sin acordeones). */
interface Props { preguntas: readonly { p: string; r: string }[] }
const { preguntas } = Astro.props;
---

<dl class="divide-y divide-slate-200 rounded-3xl bg-white px-7 shadow-sm ring-1 ring-slate-200">
  {preguntas.map((q) => (
    <div class="py-6">
      <dt class="text-lg font-bold text-marca-900">{q.p}</dt>
      <dd class="mt-2 text-slate-600">{q.r}</dd>
    </div>
  ))}
</dl>
