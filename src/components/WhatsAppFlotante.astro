---
import { site } from '../config/site';
const texto = encodeURIComponent('Hola CLASTEC, quisiera información sobre sus servicios.');
---

<a
  href={`https://wa.me/${site.whatsapp}?text=${texto}`}
  rel="noopener noreferrer"
  target="_blank"
  class="fixed bottom-4 right-4 z-40 hidden md:inline-flex min-h-14 items-center gap-2 rounded-full bg-[#1a7f3c] px-5 py-3 font-semibold text-white shadow-lg hover:bg-[#146a31]"
  aria-label="Escribir a CLASTEC por WhatsApp (se abre en una pestaña nueva)"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-current"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
  <span>WhatsApp</span>
</a>
