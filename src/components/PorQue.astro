---
import { alianzas, certificaciones, site } from '../config/site';
const pasos = [
  { t: 'Nos cuentas tu necesidad', d: 'Por el formulario, WhatsApp o teléfono.' },
  { t: 'Evaluamos y proponemos', d: 'Analizamos tu consumo y tus equipos, y te enviamos una propuesta clara.' },
  { t: 'Implementamos y damos soporte', d: 'Instalamos, capacitamos a tu equipo y te acompañamos con soporte técnico.' },
];
---

<section id="por-que-clastec" aria-labelledby="pq-titulo" class="contenedor py-16">
  <h2 id="pq-titulo" class="text-3xl font-bold text-marca-900">Por qué elegir CLASTEC</h2>
  <div class="mt-10 grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="text-lg font-semibold text-marca-900">Alianzas con los fabricantes</h3>
      <ul class="mt-4 space-y-3">
        {alianzas.map((a) => (
          <li class="rounded-lg border border-slate-200 p-4">
            <span class="font-bold text-marca-900">{a.nombre}</span>
            <span class="block text-sm text-slate-700">{a.detalle}</span>
          </li>
        ))}
      </ul>
      <h3 class="mt-8 text-lg font-semibold text-marca-900">Personal certificado en</h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {certificaciones.map((c) => (
          <li class="rounded-full bg-marca-50 px-3 py-1 text-sm font-medium text-marca-900">{c}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="text-lg font-semibold text-marca-900">Cómo trabajamos</h3>
      <ol class="mt-4 space-y-4">
        {pasos.map((p, i) => (
          <li class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-marca-700 font-bold text-white" aria-hidden="true">{i + 1}</span>
            <div>
              <p class="font-semibold">{p.t}</p>
              <p class="text-slate-700">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-slate-700">
        Desde {site.fundacion.anio}, con presencia en {site.cifras.departamentos} departamentos
        ({site.cifras.departamentosConPersonal} con personal propio).
      </p>
    </div>
  </div>
</section>
