---
import { site } from '../config/site';
import Icono from './Icono.astro';
interface Props { titulo?: string; texto?: string; servicio?: string }
const {
  titulo = '¿Listo para reducir costos y mejorar tu operación?',
  texto = 'Cuéntanos qué necesitas y recibe una propuesta en menos de 24 horas hábiles.',
  servicio,
} = Astro.props;
const href = servicio ? `/cotizar/?servicio=${encodeURIComponent(servicio)}` : '/cotizar/';
---

<section class="bg-oro-500">
  <div class="contenedor flex flex-col items-start justify-between gap-8 py-14 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold text-marca-950 sm:text-4xl">{titulo}</h2>
      <p class="mt-3 text-lg text-marca-900">{texto}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={href} class="btn bg-marca-950 text-white hover:bg-marca-800">Solicitar cotización<Icono nombre="flecha" class="h-5 w-5" /></a>
      <a href={`tel:${site.telefonos[0]?.numero}`} class="btn border-2 border-marca-950 text-marca-950 hover:bg-white/30"><Icono nombre="telefono" class="h-5 w-5" />Llamar ahora</a>
    </div>
  </div>
</section>
