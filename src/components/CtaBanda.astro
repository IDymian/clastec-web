---
import { site } from '../config/site';
interface Props { titulo?: string; texto?: string; servicio?: string }
const {
  titulo = '¿Listo para reducir costos y mejorar tu operación?',
  texto = 'Cuéntanos qué necesitas y recibe una propuesta en menos de 24 horas hábiles.',
  servicio,
} = Astro.props;
const href = servicio ? `/contacto/?servicio=${encodeURIComponent(servicio)}` : '/contacto/';
---

<section class="bg-gradient-to-r from-marca-900 to-marca-700 text-white">
  <div class="contenedor flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center">
    <div>
      <h2 class="text-3xl font-bold">{titulo}</h2>
      <p class="mt-2 text-slate-200">{texto}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={href} class="btn-primario">Solicitar cotización</a>
      <a href={`tel:${site.telefonos[0]?.numero}`} class="btn-claro">Llamar ahora</a>
    </div>
  </div>
</section>
