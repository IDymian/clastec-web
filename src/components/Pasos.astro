---
interface Props { pasos: readonly { t: string; d: string }[]; etiqueta?: string }
const { pasos, etiqueta = 'Paso' } = Astro.props;
const columnas = pasos.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';
---

<ol class:list={['grid gap-6 sm:grid-cols-2', columnas]}>
  {pasos.map((p, i) => (
    <li class="rounded-3xl bg-white p-7 shadow-sm ring-1 ring-slate-200">
      <span class="font-titulo text-5xl font-bold text-oro-500" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="mt-3 text-xl font-bold text-marca-900"><span class="sr-only">{etiqueta} {i + 1}: </span>{p.t}</h3>
      <p class="mt-2 text-slate-600">{p.d}</p>
    </li>
  ))}
</ol>
