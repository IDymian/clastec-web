---
import { site } from '../config/site';
---

<section class="bg-gradient-to-b from-marca-50 to-white">
  <div class="contenedor py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-wide text-marca-700">
      Partner Platinum de Xerox · {site.aniosExperiencia} años en el Perú
    </p>
    <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight text-marca-900 sm:text-5xl">
      Outsourcing de impresión y servicios de TI para empresas y entidades públicas
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-slate-700">
      Reducimos tus costos de impresión y mantenemos tus equipos operativos con alquiler, mantenimiento,
      digitalización y mesa de ayuda, en {site.cifras.departamentos} departamentos del país.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="#cotizar" class="btn-primario">Solicitar cotización</a>
      <a href="#servicios" class="btn-secundario">Ver servicios</a>
    </div>
    <p class="mt-6 text-sm text-slate-600">Respuesta en menos de 24 horas hábiles · {site.horario}</p>
  </div>
</section>
