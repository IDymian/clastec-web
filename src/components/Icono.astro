---
import { trazos, type NombreIcono } from '../lib/iconos';

interface Props { nombre: NombreIcono; class?: string }
const { nombre, class: clase = 'h-6 w-6' } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={clase}>
  <path d={trazos[nombre]} />
</svg>
