---
import { site } from '../config/site';
const formato = new Intl.NumberFormat('es-PE');
// Cifras estáticas (sin contadores animados): visibles aunque no se ejecute JavaScript.
const cifras = [
  { valor: `${site.aniosExperiencia}`, texto: 'años de experiencia' },
  { valor: `${site.cifras.departamentos}`, texto: 'departamentos atendidos' },
  { valor: `${site.cifras.contratosActivos}`, texto: 'contratos activos' },
  { valor: `+${formato.format(site.cifras.equiposAdministrados)}`, texto: 'equipos administrados' },
];
---

<section aria-labelledby="cifras-titulo" class="border-y border-slate-200 bg-white">
  <h2 id="cifras-titulo" class="sr-only">CLASTEC en cifras</h2>
  <dl class="contenedor grid grid-cols-2 gap-6 py-10 text-center lg:grid-cols-4">
    {cifras.map((c) => (
      <div class="flex flex-col-reverse">
        <dt class="text-sm text-slate-600">{c.texto}</dt>
        <dd class="text-3xl font-extrabold text-marca-700">{c.valor}</dd>
      </div>
    ))}
  </dl>
</section>
