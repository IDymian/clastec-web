---
/** Cabecera de páginas internas: botón "Volver", migas, título (único h1), bajada y acciones. */
import Migas from './Migas.astro';
import Icono from './Icono.astro';

interface Props {
  titulo: string;
  bajada?: string;
  eyebrow?: string;
  migas: readonly { texto: string; href?: string }[];
}
const { titulo, bajada, eyebrow, migas } = Astro.props;
const anteriores = migas.filter((m) => m.href);
const padre = anteriores.at(-1) ?? { texto: 'Inicio', href: '/' };
---

<section class="relative overflow-hidden bg-marca-950 text-white">
  <div class="hero-fondo absolute inset-0" aria-hidden="true"></div>
  <div class="contenedor relative py-12 sm:py-16">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-300">
      <a href={padre.href} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-white/10 px-4 font-semibold text-white ring-1 ring-white/15 hover:bg-white/20">
        <Icono nombre="volver" class="h-4 w-4" />Volver a {padre.texto}
      </a>
      <Migas items={migas} />
    </div>
    {eyebrow && <p class="mt-8 text-sm font-bold uppercase tracking-widest text-oro-400">{eyebrow}</p>}
    <h1 class:list={['max-w-3xl text-4xl font-bold leading-tight sm:text-5xl', eyebrow ? 'mt-3' : 'mt-8']}>{titulo}</h1>
    {bajada && <p class="mt-5 max-w-2xl text-lg text-slate-300">{bajada}</p>}
    <div class="mt-8 flex flex-wrap gap-3"><slot /></div>
  </div>
</section>
