---
/** Cabecera de páginas internas: migas, título (único h1), bajada y acciones. */
import Migas from './Migas.astro';

interface Props {
  titulo: string;
  bajada?: string;
  eyebrow?: string;
  migas: readonly { texto: string; href?: string }[];
}
const { titulo, bajada, eyebrow, migas } = Astro.props;
---

<section class="bg-marca-900 text-white">
  <div class="contenedor py-12 sm:py-16">
    <div class="text-slate-200"><Migas items={migas} /></div>
    {eyebrow && <p class="mt-6 text-sm font-bold uppercase tracking-wider text-oro-400">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl font-bold leading-tight sm:text-5xl">{titulo}</h1>
    {bajada && <p class="mt-4 max-w-2xl text-lg text-slate-200">{bajada}</p>}
    <div class="mt-8 flex flex-wrap gap-3"><slot /></div>
  </div>
</section>
