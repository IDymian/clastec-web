---
import { site } from '../config/site';
import { servicios } from '../content/servicios';
const anio = new Date().getFullYear();
const empresa = [
  { href: '/nosotros/', t: 'Nosotros' },
  { href: '/sector-publico/', t: 'Sector público' },
  { href: '/catalogo/', t: 'Catálogo' },
  { href: '/preguntas-frecuentes/', t: 'Preguntas frecuentes' },
  { href: '/contacto/', t: 'Contacto' },
];
---

<footer class="bg-marca-950 text-slate-300">
  <div class="contenedor grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <p class="font-titulo text-3xl font-bold text-white">CLASTEC</p>
      <p class="mt-2 max-w-sm text-sm">Outsourcing de impresión y servicios de TI para empresas y entidades públicas desde {site.fundacion.anio}. Partner Platinum de Xerox.</p>
      <ul class="mt-5 space-y-2 text-sm">
        {site.telefonos.map((t) => <li><a class="hover:text-white hover:underline" href={`tel:${t.numero}`}>{t.visible}</a></li>)}
        <li><a class="hover:text-white hover:underline" href={`mailto:${site.correoVentas}`}>{site.correoVentas}</a></li>
        <li>{site.horario}</li>
        <li>{site.direccion ?? site.ubicacion}</li>
      </ul>
    </div>
    <div>
      <h2 class="font-titulo text-lg font-bold text-white">Servicios</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {servicios.map((s) => <li><a class="hover:text-white hover:underline" href={`/servicios/${s.id}/`}>{s.titulo}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-titulo text-lg font-bold text-white">Empresa</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {empresa.map((e) => <li><a class="hover:text-white hover:underline" href={e.href}>{e.t}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-titulo text-lg font-bold text-white">Legal</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="hover:text-white hover:underline" href="/privacidad/">Política de privacidad</a></li>
        <li><a class="hover:text-white hover:underline" href="/libro-de-reclamaciones/">Libro de Reclamaciones</a></li>
        <li><a class="hover:text-white hover:underline" href={site.redes.facebook} rel="noopener noreferrer">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="contenedor py-5 pb-24 text-xs sm:pb-5">© {anio} {site.razonSocial} · RUC {site.ruc}</p>
  </div>
</footer>
