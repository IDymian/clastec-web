---
import { site } from '../config/site';
import { menuPrincipal, esActivo } from '../config/navegacion';
import Icono from './Icono.astro';

const ruta = Astro.url.pathname;
---

<!-- Barra de ayuda: teléfono visible y control de tamaño de letra -->
<div class="bg-marca-950 text-white">
  <div class="contenedor flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2">
    <p class="flex flex-wrap items-center gap-x-2">
      <span>¿Necesitas ayuda? Llámanos:</span>
      <a class="inline-flex min-h-11 items-center gap-2 font-bold text-oro-400 underline underline-offset-4" href={`tel:${site.telefonos[0]?.numero}`}>
        <Icono nombre="telefono" class="h-5 w-5" />{site.telefonos[0]?.visible}
      </a>
    </p>
    <div class="flex items-center gap-2" role="group" aria-label="Tamaño de letra">
      <span id="tamano-etiqueta">Tamaño de letra:</span>
      <button type="button" data-tamano="" aria-describedby="tamano-etiqueta" class="min-h-11 min-w-11 rounded-lg border-2 border-white/40 px-2 font-bold aria-pressed:border-oro-400 aria-pressed:bg-white aria-pressed:text-marca-950" aria-label="Letra normal">A</button>
      <button type="button" data-tamano="texto-grande" aria-describedby="tamano-etiqueta" class="min-h-11 min-w-11 rounded-lg border-2 border-white/40 px-2 text-lg font-bold aria-pressed:border-oro-400 aria-pressed:bg-white aria-pressed:text-marca-950" aria-label="Letra grande">A+</button>
      <button type="button" data-tamano="texto-muy-grande" aria-describedby="tamano-etiqueta" class="min-h-11 min-w-11 rounded-lg border-2 border-white/40 px-2 text-xl font-bold aria-pressed:border-oro-400 aria-pressed:bg-white aria-pressed:text-marca-950" aria-label="Letra muy grande">A++</button>
    </div>
  </div>
</div>

<header class="bg-marca-900 text-white">
  <div class="contenedor flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-3" aria-label="CLASTEC, ir a la página de inicio">
      <span class="grid h-11 w-11 grid-cols-2 gap-0.5" aria-hidden="true">
        <span class="rounded-sm bg-oro-500"></span><span class="rounded-sm bg-oro-400"></span>
        <span class="rounded-sm bg-oro-400"></span><span class="rounded-sm bg-oro-500"></span>
      </span>
      <span>
        <span class="block font-titulo text-3xl font-bold leading-none tracking-wide">CLASTEC</span>
        <span class="block text-sm text-slate-300">Impresión y servicios de TI</span>
      </span>
    </a>
    <div class="flex flex-wrap items-center gap-3">
      <a href="/cotizar/#lista" class="inline-flex min-h-12 items-center gap-2 rounded-xl border-2 border-white/40 px-4 font-semibold hover:bg-white/10">
        <Icono nombre="carrito" />
        <span>Mi cotización</span>
        <span data-contador-lista class="rounded-full bg-oro-500 px-2 text-base font-bold text-marca-950">0</span>
      </a>
      <a href="/cotizar/" class="btn-primario hidden sm:inline-flex">Solicitar cotización</a>
    </div>
  </div>

  <!-- Menú principal: todas las secciones a la vista, sin desplegables -->
  <nav aria-label="Menú principal" class="border-t border-white/15 bg-marca-800">
    <ul class="contenedor grid grid-cols-2 gap-1 py-2 sm:grid-cols-4 lg:flex lg:justify-between lg:gap-0">
      {menuPrincipal.map((e) => {
        const activo = esActivo(ruta, e.href);
        return (
          <li>
            <a
              href={e.href}
              aria-current={activo ? 'page' : undefined}
              class="flex min-h-12 items-center gap-2 rounded-lg px-3 py-2 font-semibold hover:bg-white/10 aria-[current=page]:bg-white aria-[current=page]:text-marca-950"
            >
              <Icono nombre={e.icono} class="h-5 w-5 shrink-0" />
              {e.texto}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  import { contarLista, LISTA_EVENTO } from '../lib/lista.ts';

  // Tamaño de letra (se recuerda en este navegador).
  const CLAVE = 'clastec:tamano-letra';
  const clases = ['texto-grande', 'texto-muy-grande'];
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-tamano]');
  const marcar = (actual: string) => botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset['tamano'] === actual)));
  const actual = clases.find((c) => document.documentElement.classList.contains(c)) ?? '';
  marcar(actual);
  botones.forEach((b) =>
    b.addEventListener('click', () => {
      const elegido = b.dataset['tamano'] ?? '';
      document.documentElement.classList.remove(...clases);
      if (elegido) document.documentElement.classList.add(elegido);
      try { localStorage.setItem(CLAVE, elegido); } catch { /* sin almacenamiento */ }
      marcar(elegido);
    }),
  );

  // Contador de la lista de cotización.
  const contadores = document.querySelectorAll<HTMLElement>('[data-contador-lista]');
  const pintar = () => {
    const n = contarLista();
    contadores.forEach((c) => {
      c.textContent = String(n);
      c.setAttribute('aria-label', `${n} producto${n === 1 ? '' : 's'}`);
    });
  };
  pintar();
  window.addEventListener(LISTA_EVENTO, pintar);
  window.addEventListener('storage', pintar);
</script>
