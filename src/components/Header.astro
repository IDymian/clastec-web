---
import { site } from '../config/site';
import { menuPrincipal, esActivo } from '../config/navegacion';
import Icono from './Icono.astro';

const ruta = Astro.url.pathname;
---

<!-- Barra de contacto: datos clave siempre a la vista en escritorio -->
<div class="hidden bg-marca-950 text-sm text-slate-200 md:block">
  <div class="contenedor flex items-center justify-between gap-6 py-2">
    <ul class="flex items-center gap-6">
      <li>
        <a class="inline-flex items-center gap-2 hover:text-white" href={`tel:${site.telefonos[0]?.numero}`}>
          <Icono nombre="telefono" class="h-4 w-4 text-oro-400" />{site.telefonos[0]?.visible}
        </a>
      </li>
      <li>
        <a class="inline-flex items-center gap-2 hover:text-white" href={`mailto:${site.correoVentas}`}>
          <Icono nombre="correo" class="h-4 w-4 text-oro-400" />{site.correoVentas}
        </a>
      </li>
      <li class="hidden items-center gap-2 lg:inline-flex"><Icono nombre="reloj" class="h-4 w-4 text-oro-400" />{site.horario}</li>
    </ul>
    <p class="inline-flex items-center gap-2 font-semibold text-oro-400">
      <Icono nombre="escudo" class="h-4 w-4" />Partner Platinum de Xerox
    </p>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
  <div class="contenedor flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 xl:flex-nowrap">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label="CLASTEC, ir a la página de inicio">
      <span class="grid h-10 w-10 grid-cols-2 gap-0.5" aria-hidden="true">
        <span class="rounded-sm bg-marca-900"></span><span class="rounded-sm bg-oro-500"></span>
        <span class="rounded-sm bg-oro-500"></span><span class="rounded-sm bg-marca-900"></span>
      </span>
      <span>
        <span class="block font-titulo text-2xl font-bold leading-none tracking-wide text-marca-900">CLASTEC</span>
        <span class="block text-xs font-medium uppercase tracking-wider text-slate-600">Impresión y servicios de TI</span>
      </span>
    </a>

    <!-- Menú principal: todas las secciones a la vista, sin desplegables -->
    <nav aria-label="Menú principal" class="order-last w-full xl:order-none xl:w-auto">
      <ul class="-mx-4 flex gap-1 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6 xl:mx-0 xl:overflow-visible xl:px-0 xl:pb-0">
        {menuPrincipal.map((e) => {
          const activo = esActivo(ruta, e.href);
          return (
            <li class="shrink-0">
              <a
                href={e.href}
                aria-current={activo ? 'page' : undefined}
                class="inline-flex min-h-11 items-center rounded-full px-4 text-[0.95rem] xl:px-3 font-semibold text-slate-700 hover:bg-marca-50 hover:text-marca-900 aria-[current=page]:bg-marca-900 aria-[current=page]:text-white"
              >
                {e.texto}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a href="/cotizar/#lista" class="relative inline-flex h-11 w-11 items-center justify-center rounded-full text-marca-900 hover:bg-marca-50" aria-label="Mi lista de cotización">
        <Icono nombre="carrito" class="h-6 w-6" />
        <span data-contador-lista class="absolute -right-0.5 -top-0.5 min-w-5 rounded-full bg-oro-500 px-1 text-center text-xs font-bold leading-5 text-marca-950">0</span>
      </a>
      <a href="/cotizar/" class="btn-primario hidden sm:inline-flex">Cotizar ahora</a>
    </div>
  </div>
</header>

<script>
  import { contarLista, LISTA_EVENTO } from '../lib/lista.ts';

  // Contador de la lista de cotización.
  const contadores = document.querySelectorAll<HTMLElement>('[data-contador-lista]');
  const pintar = () => {
    const n = contarLista();
    contadores.forEach((c) => {
      c.textContent = String(n);
      c.setAttribute('aria-label', `${n} producto${n === 1 ? '' : 's'}`);
    });
  };
  pintar();
  window.addEventListener(LISTA_EVENTO, pintar);
  window.addEventListener('storage', pintar);
</script>
