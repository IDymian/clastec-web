---
const enlaces = [
  { href: '/#servicios', texto: 'Servicios' },
  { href: '/#sector-publico', texto: 'Sector público' },
  { href: '/#por-que-clastec', texto: 'Por qué CLASTEC' },
  { href: '/#preguntas', texto: 'Preguntas' },
  { href: '/#cotizar', texto: 'Contacto' },
] as const;
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="contenedor flex h-16 items-center justify-between gap-4">
    <a href="/" class="text-2xl font-extrabold tracking-tight text-marca-900" aria-label="CLASTEC, ir al inicio">
      CLAS<span class="text-marca-600">TEC</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {enlaces.map((e) => <li><a class="py-2 hover:text-marca-600" href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="#cotizar" class="btn-primario hidden text-sm sm:inline-flex">Solicitar cotización</a>
      <details class="relative lg:hidden">
        <summary class="btn-secundario cursor-pointer list-none px-3 text-sm" aria-label="Abrir menú">Menú</summary>
        <nav aria-label="Móvil" class="absolute right-0 mt-2 w-60 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
          <ul>
            {enlaces.map((e) => <li><a class="block rounded px-3 py-3 hover:bg-marca-50" href={e.href}>{e.texto}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
