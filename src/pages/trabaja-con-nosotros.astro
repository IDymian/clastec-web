---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Icono from '../components/Icono.astro';
import { certificaciones, site } from '../config/site';

// Perfiles que la empresa ha publicado en su sitio (avisos de 2021). Las vacantes vigentes las debe confirmar la empresa.
const perfiles = [
  { t: 'Operador de servicio de impresión y fotocopiado', d: 'Atiende los equipos instalados en las sedes de nuestros clientes.' },
  { t: 'Supervisor de servicio de impresión', d: 'Coordina a los operadores y vela por la calidad del servicio.' },
  { t: 'Técnico titulado en cómputo y redes', d: 'Mantenimiento de computadoras, servidores y redes.' },
  { t: 'Técnico egresado de soporte informático', d: 'Soporte a usuarios, remoto y presencial.' },
];
const asunto = encodeURIComponent('Postulación - Trabaja con nosotros');
---

<Base title="Trabaja con nosotros | CLASTEC" description="Únete al equipo de CLASTEC: operadores de impresión, supervisores y técnicos de soporte y redes en todo el Perú.">
  <Cabecera
    titulo="Trabaja con nosotros"
    bajada="Sé parte de un equipo con más de 20 años brindando servicios de tecnología en todo el Perú."
    migas={[{ texto: 'Trabaja con nosotros' }]}
  />

  <section class="contenedor py-14" aria-labelledby="perfiles">
    <h2 id="perfiles" class="text-3xl font-bold text-marca-900">Perfiles que solemos buscar</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {perfiles.map((p) => (
        <li class="flex gap-5 rounded-2xl border-2 border-slate-200 p-6">
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-marca-900 text-oro-400"><Icono nombre="trabajo" class="h-7 w-7" /></span>
          <div><h3 class="text-2xl font-bold text-marca-900">{p.t}</h3><p class="mt-1 text-lg text-slate-800">{p.d}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-slate-100" aria-labelledby="ofrecemos">
    <div class="contenedor grid gap-10 py-14 md:grid-cols-2">
      <div>
        <h2 id="ofrecemos" class="text-3xl font-bold text-marca-900">Qué te ofrecemos</h2>
        <ul class="mt-6 space-y-3 text-xl">
          <li class="flex gap-3"><span class="mt-1 text-marca-600"><Icono nombre="check" class="h-6 w-6" /></span>Capacitación constante.</li>
          <li class="flex gap-3"><span class="mt-1 text-marca-600"><Icono nombre="check" class="h-6 w-6" /></span>Certificaciones en {certificaciones.join(', ')}.</li>
          <li class="flex gap-3"><span class="mt-1 text-marca-600"><Icono nombre="check" class="h-6 w-6" /></span>Trabajo en Lima y en regiones.</li>
        </ul>
      </div>
      <div class="rounded-2xl bg-white p-6 ring-2 ring-slate-200">
        <h2 class="text-2xl font-bold text-marca-900">¿Cómo postular?</h2>
        <p class="mt-2 text-xl text-slate-800">Envíanos tu CV indicando el puesto que te interesa.</p>
        <a href={`mailto:${site.correoVentas}?subject=${asunto}`} class="btn-primario mt-6">Enviar mi CV por correo</a>
        <p class="mt-3 text-base text-slate-700">Correo provisional del prototipo: la empresa debe indicar el correo de Recursos Humanos.</p>
      </div>
    </div>
  </section>
</Base>
