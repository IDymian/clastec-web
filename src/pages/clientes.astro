---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Icono from '../components/Icono.astro';
import Testimonios from '../components/Testimonios.astro';
import CtaBanda from '../components/CtaBanda.astro';
import { entidadesPublicas, site, testimonios } from '../config/site';

// Empresas privadas mencionadas en los testimonios del sitio actual (permiso de uso pendiente).
const privadas = [...new Set(testimonios.map((t) => t.entidad).filter((e) => !/corte|csj|ministerio/i.test(e)))];
const sectores = ['Justicia', 'Cultura', 'Comercio exterior y turismo', 'Organismos electorales', 'Construcción e inmobiliario', 'Empresas de servicios'];
---

<Base title="Clientes y testimonios | CLASTEC" description={`Más de ${site.cifras.clientes} clientes entre entidades públicas y empresas privadas confían en CLASTEC. Lee sus testimonios.`}>
  <Cabecera
    titulo="Clientes y testimonios"
    bajada={`Más de ${site.cifras.clientes} clientes y ${site.cifras.contratosActivos} contratos activos en el Perú.`}
    migas={[{ texto: 'Clientes y testimonios' }]}
  />

  <section class="contenedor grid gap-10 py-14 lg:grid-cols-2" aria-labelledby="entidades">
    <div>
      <h2 id="entidades" class="text-3xl font-bold text-marca-900">Entidades públicas</h2>
      <ul class="mt-6 space-y-3">
        {entidadesPublicas.map((e) => (
          <li class="flex min-h-16 items-center gap-4 rounded-2xl border-2 border-slate-200 px-5 text-xl font-semibold text-marca-900">
            <span class="text-oro-700"><Icono nombre="escudo" class="h-7 w-7" /></span>{e}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-3xl font-bold text-marca-900">Empresas privadas</h2>
      <ul class="mt-6 space-y-3">
        {privadas.map((e) => (
          <li class="flex min-h-16 items-center gap-4 rounded-2xl border-2 border-slate-200 px-5 text-xl font-semibold text-marca-900">
            <span class="text-oro-700"><Icono nombre="trabajo" class="h-7 w-7" /></span>{e}
          </li>
        ))}
      </ul>
      <h2 class="mt-10 text-2xl font-bold text-marca-900">Sectores que atendemos</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {sectores.map((s) => <li class="rounded-full bg-marca-50 px-4 py-2 text-lg font-semibold text-marca-900">{s}</li>)}
      </ul>
    </div>
  </section>

  <Testimonios />
  <CtaBanda titulo="¿Quieres ser nuestro próximo cliente?" texto="Te preparamos una propuesta a la medida de tu empresa o entidad." />
</Base>
