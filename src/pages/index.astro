---
/**
 * Inicio: página corta que funciona como "recepción". Responde qué hace CLASTEC y lleva a cada
 * sección con tarjetas grandes. El detalle vive en páginas propias (no todo en una sola vista).
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Mosaico from '../components/Mosaico.astro';
import { alianzas, site } from '../config/site';
import { servicios } from '../content/servicios';

const fmt = new Intl.NumberFormat('es-PE');
const cifras = [
  { valor: `${site.aniosExperiencia}`, texto: 'años de experiencia' },
  { valor: `+${site.cifras.clientes}`, texto: 'clientes' },
  { valor: `+${fmt.format(site.cifras.equiposAdministrados)}`, texto: 'equipos administrados' },
  { valor: `${site.cifras.departamentos}`, texto: 'departamentos del Perú' },
];
const conoceMas = [
  { href: '/catalogo/', icono: 'buscar', t: 'Catálogo de productos', d: 'Impresoras, laptops, escáneres, repuestos y suministros.', a: 'Ver el catálogo' },
  { href: '/sector-publico/', icono: 'escudo', t: 'Sector público', d: 'Experiencia con Cortes de Justicia, ministerios y licitaciones.', a: 'Ver experiencia' },
  { href: '/clientes/', icono: 'usuarios', t: 'Clientes y testimonios', d: 'Lo que dicen las entidades y empresas que atendemos.', a: 'Leer testimonios' },
  { href: '/como-trabajamos/', icono: 'reloj', t: 'Cómo trabajamos', d: 'Los pasos, los tiempos de atención y la cobertura nacional.', a: 'Ver cómo trabajamos' },
  { href: '/guias/comprar-o-alquilar/', icono: 'grafico', t: '¿Comprar o alquilar?', d: 'Una guía sencilla para decidir qué te conviene.', a: 'Leer la guía' },
  { href: '/preguntas-frecuentes/', icono: 'pregunta', t: 'Preguntas frecuentes', d: 'Pagos, entregas, alquiler y soporte técnico.', a: 'Ver preguntas' },
] as const;
---

<Base
  title="CLASTEC | Outsourcing de impresión y servicios de TI en Perú"
  description={`Outsourcing de impresión, alquiler de equipos, mantenimiento, digitalización y mesa de ayuda TI. Partner Platinum de Xerox con ${site.aniosExperiencia} años en el Perú.`}
>
  <section class="bg-marca-900 text-white">
    <div class="contenedor grid items-center gap-10 py-14 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-8">
        <p class="text-lg font-bold uppercase tracking-wider text-oro-400">Partner Platinum de Xerox · {site.aniosExperiencia} años en el Perú</p>
        <h1 class="mt-3 text-4xl font-bold sm:text-6xl">Impresoras y equipos de TI que funcionan, sin preocupaciones</h1>
        <p class="mt-5 max-w-2xl text-xl text-slate-100">
          Ponemos los equipos, el tóner y el soporte técnico para empresas y entidades públicas en {site.cifras.departamentos} departamentos del país.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/cotizar/" class="btn-primario">Solicitar cotización</a>
          <a href={`tel:${site.telefonos[0]?.numero}`} class="btn-claro"><Icono nombre="telefono" class="h-6 w-6" />Llamar al {site.telefonos[0]?.visible}</a>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-4 lg:col-span-4">
        {cifras.map((c) => (
          <div class="flex flex-col-reverse rounded-2xl bg-white/10 p-5 text-center ring-1 ring-white/20">
            <dt class="text-base text-slate-100">{c.texto}</dt>
            <dd class="font-titulo text-5xl font-bold text-oro-400">{c.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="contenedor py-14" aria-labelledby="necesitas">
    <h2 id="necesitas" class="text-3xl font-bold text-marca-900 sm:text-4xl">¿Qué necesitas?</h2>
    <p class="mt-2 text-xl text-slate-800">Elige una opción para ver el detalle.</p>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.map((s) => (
        <li><Mosaico href={`/servicios/${s.id}/`} titulo={s.titulo} texto={s.resumen} icono={s.icono} accion="Ver este servicio" /></li>
      ))}
      <li><Mosaico href="/cotizar/" titulo="No estoy seguro" texto="Cuéntanos tu caso y te recomendamos la mejor opción." icono="pregunta" accion="Pedir asesoría" oscuro /></li>
    </ul>
  </section>

  <section class="bg-slate-100" aria-labelledby="conoce">
    <div class="contenedor py-14">
      <h2 id="conoce" class="text-3xl font-bold text-marca-900 sm:text-4xl">Conoce más</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {conoceMas.map((m) => <li><Mosaico href={m.href} titulo={m.t} texto={m.d} icono={m.icono} accion={m.a} /></li>)}
      </ul>
    </div>
  </section>

  <section class="contenedor py-12" aria-labelledby="respaldo">
    <h2 id="respaldo" class="text-center text-2xl font-bold text-marca-900">Con el respaldo de las marcas líderes</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {alianzas.map((a) => (
        <li class="rounded-2xl border-2 border-slate-200 p-5 text-center">
          <span class="block font-titulo text-3xl font-bold text-marca-900">{a.nombre}</span>
          <span class="text-lg text-slate-800">{a.nivel}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
