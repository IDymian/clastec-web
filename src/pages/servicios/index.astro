---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Mosaico from '../../components/Mosaico.astro';
import CtaBanda from '../../components/CtaBanda.astro';
import { servicios } from '../../content/servicios';
---

<Base title="Servicios de impresión y TI para empresas | CLASTEC" description="Outsourcing de impresión, alquiler de equipos, mantenimiento, digitalización de documentos y mesa de ayuda de TI en todo el Perú.">
  <Cabecera
    titulo="Nuestros servicios"
    bajada="Contrata uno o combínalos en un solo contrato, con un solo proveedor y una sola factura."
    migas={[{ texto: 'Servicios' }]}
  >
    <a href="/cotizar/" class="btn-primario">Solicitar cotización</a>
  </Cabecera>

  <section class="contenedor py-16 sm:py-20">
    <h2 class="text-3xl font-bold text-marca-900 sm:text-4xl">Elige un servicio para ver el detalle</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {servicios.map((s) => (
        <li><Mosaico href={`/servicios/${s.id}/`} titulo={s.titulo} texto={s.resumen} icono={s.icono} accion="Ver este servicio" /></li>
      ))}
      <li><Mosaico href="/guias/comprar-o-alquilar/" titulo="¿No sabes si comprar o alquilar?" texto="Te explicamos en 3 minutos qué conviene en cada caso." icono="pregunta" accion="Leer la guía" oscuro /></li>
    </ul>
  </section>

  <CtaBanda />
</Base>
