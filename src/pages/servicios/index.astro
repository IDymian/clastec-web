---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Icono from '../../components/Icono.astro';
import CtaBanda from '../../components/CtaBanda.astro';
import { servicios } from '../../content/servicios';
---

<Base title="Servicios de impresión y TI para empresas | CLASTEC" description="Outsourcing de impresión, alquiler de equipos, mantenimiento, digitalización de documentos y mesa de ayuda de TI en todo el Perú.">
  <Cabecera
    titulo="Servicios de impresión y TI"
    bajada="Contrata uno o combínalos en un solo contrato, con un solo proveedor y una sola factura."
    migas={[{ texto: 'Servicios' }]}
  >
    <a href="/contacto/" class="btn-primario">Solicitar cotización</a>
  </Cabecera>

  <section class="contenedor py-16">
    <h2 class="sr-only">Lista de servicios</h2>
    <ul class="grid gap-6 md:grid-cols-2">
      {servicios.map((s) => (
        <li class="flex flex-col rounded-2xl border border-slate-200 p-8 shadow-sm">
          <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-marca-900 text-oro-400"><Icono nombre={s.icono} class="h-7 w-7" /></span>
          <h3 class="mt-5 text-2xl font-bold text-marca-900">{s.titulo}</h3>
          <p class="mt-2 text-slate-700">{s.resumen}</p>
          <ul class="mt-4 space-y-1 text-sm text-slate-700">
            {s.beneficios.slice(0, 3).map((b) => <li class="flex gap-2"><span class="text-marca-600"><Icono nombre="check" class="h-5 w-5" /></span>{b.t}</li>)}
          </ul>
          <div class="mt-auto flex flex-wrap gap-3 pt-6">
            <a href={`/servicios/${s.id}/`} class="btn-secundario">Ver detalle<span class="sr-only"> de {s.titulo}</span></a>
            <a href={`/contacto/?servicio=${encodeURIComponent(s.titulo)}`} class="btn-primario">Cotizar<span class="sr-only"> {s.titulo}</span></a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <CtaBanda />
</Base>
