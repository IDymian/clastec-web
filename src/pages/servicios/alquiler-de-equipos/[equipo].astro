---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/Cabecera.astro';
import Icono from '../../../components/Icono.astro';
import Mosaico from '../../../components/Mosaico.astro';
import ListaPreguntas from '../../../components/ListaPreguntas.astro';
import CtaBanda from '../../../components/CtaBanda.astro';
import { equiposAlquiler, servicioPorId, type EquipoAlquiler } from '../../../content/servicios';
import { CATEGORIAS } from '../../../lib/catalogo';
import { site } from '../../../config/site';

export const getStaticPaths = (() => equiposAlquiler.map((e) => ({ params: { equipo: e.id }, props: { e } }))) satisfies GetStaticPaths;

interface Props { e: EquipoAlquiler }
const { e } = Astro.props;
const alquiler = servicioPorId('alquiler-de-equipos');
const categoria = e.catalogo ? CATEGORIAS.find((c) => c.slug === e.catalogo) : undefined;
const otros = equiposAlquiler.filter((o) => o.id !== e.id);
const cotizar = `/cotizar/?servicio=${encodeURIComponent(alquiler?.titulo ?? '')}&detalle=${encodeURIComponent(`Quisiera alquilar: ${e.t}. Cantidad: … Plazo: …`)}`;
const titulo = `Alquiler de ${e.t.toLowerCase()}`;
---

<Base title={`${titulo} | CLASTEC`} description={`${e.d} Mantenimiento, equipo de respaldo y soporte incluidos. Desde un equipo por un mes.`}>
  <Cabecera
    titulo={titulo}
    bajada={e.d}
    eyebrow="Alquiler de equipos"
    migas={[{ texto: 'Servicios', href: '/servicios/' }, { texto: 'Alquiler', href: '/servicios/alquiler-de-equipos/' }, { texto: e.t }]}
  >
    <a href={cotizar} class="btn-primario">Cotizar este alquiler</a>
    <a href={`tel:${site.telefonos[0]?.numero}`} class="btn-claro"><Icono nombre="telefono" class="h-6 w-6" />Llamar a un asesor</a>
  </Cabecera>

  <section class="contenedor grid gap-10 py-14 lg:grid-cols-2">
    <div>
      <h2 class="text-3xl font-bold text-marca-900">¿Para qué te sirve?</h2>
      <ul class="mt-6 space-y-3">
        {e.usos.map((u) => <li class="flex gap-3 text-xl text-slate-800"><span class="mt-1 text-marca-600"><Icono nombre="check" class="h-6 w-6" /></span>{u}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-3xl font-bold text-marca-900">Opciones disponibles</h2>
      <ul class="mt-6 space-y-3">
        {e.opciones.map((o) => <li class="flex gap-3 text-xl text-slate-800"><span class="mt-1 text-oro-700"><Icono nombre="check" class="h-6 w-6" /></span>{o}</li>)}
      </ul>
      {categoria && (
        <a href={`/catalogo/${categoria.slug}/`} class="btn-secundario mt-8">Ver modelos de referencia en el catálogo</a>
      )}
    </div>
  </section>

  <section class="bg-slate-100" aria-labelledby="plazos">
    <div class="contenedor py-14">
      <h2 id="plazos" class="text-3xl font-bold text-marca-900">Plazos flexibles</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-3">
        <li class="rounded-2xl bg-marca-900 p-6 text-white"><p class="font-titulo text-5xl font-bold text-oro-400">Días</p><p class="mt-1 text-lg">Para eventos y ferias.</p></li>
        <li class="rounded-2xl bg-marca-900 p-6 text-white"><p class="font-titulo text-5xl font-bold text-oro-400">Meses</p><p class="mt-1 text-lg">Para proyectos, desde un solo equipo.</p></li>
        <li class="rounded-2xl bg-marca-900 p-6 text-white"><p class="font-titulo text-5xl font-bold text-oro-400">Años</p><p class="mt-1 text-lg">Flotas completas hasta por 3 años.</p></li>
      </ul>
    </div>
  </section>

  {alquiler && (
    <section class="contenedor py-14" aria-labelledby="incluye">
      <h2 id="incluye" class="text-3xl font-bold text-marca-900">Todo alquiler incluye</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {alquiler.incluye.map((i) => (
          <li class="flex gap-4 rounded-2xl p-5 ring-2 ring-slate-200">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-marca-900 text-oro-400"><Icono nombre="check" class="h-6 w-6" /></span>
            <div><h3 class="text-xl font-bold text-marca-900">{i.t}</h3><p class="mt-1 text-lg text-slate-800">{i.d}</p></div>
          </li>
        ))}
      </ul>
      <h2 class="mt-14 text-3xl font-bold text-marca-900">Preguntas sobre el alquiler</h2>
      <div class="mt-6"><ListaPreguntas preguntas={alquiler.preguntas} /></div>
    </section>
  )}

  <CtaBanda titulo={`¿Cuántos ${e.t.toLowerCase()} necesitas?`} texto="Dinos la cantidad y el plazo, y te enviamos una propuesta." servicio={alquiler?.titulo ?? 'Alquiler de equipos informáticos'} />

  <section class="contenedor py-14" aria-labelledby="otros">
    <h2 id="otros" class="text-3xl font-bold text-marca-900">Otros equipos en alquiler</h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {otros.map((o) => <li><Mosaico href={`/servicios/alquiler-de-equipos/${o.id}/`} titulo={o.t} icono={o.icono} accion="Ver detalle" /></li>)}
    </ul>
  </section>
</Base>
