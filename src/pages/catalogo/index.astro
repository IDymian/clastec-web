---
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Mosaico from '../../components/Mosaico.astro';
import BuscadorCatalogo from '../../components/BuscadorCatalogo.astro';
import { conteoPorCategoria, fechaCaptura } from '../../lib/catalogo';

const categorias = conteoPorCategoria();
const total = categorias.reduce((n, c) => n + c.cantidad, 0);
const fmt = new Intl.NumberFormat('es-PE');
const captura = new Date(fechaCaptura).toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });
const grupos = ['Equipos', 'Repuestos y suministros'] as const;
---

<Base
  title="Catálogo de equipos, repuestos y suministros | CLASTEC"
  description={`Explora ${fmt.format(total)} productos: impresoras, multifuncionales, laptops, escáneres, repuestos y suministros. Arma tu lista y pide una cotización.`}
>
  <Cabecera
    titulo="Catálogo de productos"
    bajada={`${fmt.format(total)} productos. Elige una categoría o busca por nombre. Al final, pide una sola cotización con todo lo que elegiste.`}
    migas={[{ texto: 'Catálogo' }]}
  >
    <a href="#buscador" class="btn-primario">Buscar un producto</a>
    <a href="/cotizar/#lista" class="btn-claro">Ver mi cotización</a>
  </Cabecera>

  {grupos.map((g) => (
    <section class="contenedor py-12" aria-labelledby={`grupo-${g.length}`}>
      <h2 id={`grupo-${g.length}`} class="text-3xl font-bold text-marca-900 sm:text-4xl">{g}</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {categorias.filter((c) => c.grupo === g).map((c) => (
          <li><Mosaico href={`/catalogo/${c.slug}/`} titulo={c.nombre} texto={`${c.descripcion} ${fmt.format(c.cantidad)} productos.`} icono={c.icono} accion="Ver productos" /></li>
        ))}
      </ul>
    </section>
  ))}

  <BuscadorCatalogo titulo="O busca en todo el catálogo" />

  <p class="contenedor py-8 text-base text-slate-700">
    Catálogo de referencia actualizado el {captura}. Precios, stock y características se confirman en la cotización.
  </p>
</Base>
