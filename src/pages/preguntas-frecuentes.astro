---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import CtaBanda from '../components/CtaBanda.astro';
import { preguntasGenerales } from '../config/site';
import { servicios } from '../content/servicios';

const grupos = [
  ...preguntasGenerales.map((g) => ({ id: g.categoria.toLowerCase().normalize('NFD').replace(/[^a-z ]/g, '').replace(/\s+/g, '-'), titulo: g.categoria, preguntas: g.preguntas })),
  ...servicios.map((s) => ({ id: s.id, titulo: s.titulo, preguntas: s.preguntas })),
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: grupos.flatMap((g) => g.preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } }))),
};
---

<Base title="Preguntas frecuentes | CLASTEC" description="Respuestas sobre compras, formas de pago, delivery, alquiler de equipos, soporte técnico y cada uno de nuestros servicios." jsonLd={[ld]}>
  <Cabecera titulo="Preguntas frecuentes" bajada="Si no encuentras tu respuesta, escríbenos: respondemos en menos de 24 horas hábiles." migas={[{ texto: 'Preguntas frecuentes' }]} />

  <div class="contenedor grid gap-10 py-16 lg:grid-cols-4">
    <nav aria-label="Temas" class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600">Temas</h2>
      <ul class="mt-3 flex flex-wrap gap-2 lg:flex-col">
        {grupos.map((g) => <li><a href={`#${g.id}`} class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium text-marca-800 hover:bg-marca-50">{g.titulo}</a></li>)}
      </ul>
    </nav>
    <div class="space-y-12 lg:col-span-3">
      {grupos.map((g) => (
        <section id={g.id} aria-labelledby={`${g.id}-titulo`}>
          <h2 id={`${g.id}-titulo`} class="text-2xl font-bold text-marca-900">{g.titulo}</h2>
          <div class="mt-4 divide-y divide-slate-200 rounded-xl border border-slate-200">
            {g.preguntas.map((q) => (
              <details class="group p-5">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between font-semibold">{q.p}<span class="ml-4 text-xl text-marca-600 group-open:rotate-45" aria-hidden="true">+</span></summary>
                <p class="mt-3 text-slate-700">{q.r}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <CtaBanda titulo="¿Te quedó alguna duda?" texto="Un asesor te responde por WhatsApp, teléfono o correo." />
</Base>
